# Contact form delivery (optional).
# Without RESEND_API_KEY the form validates, then tells the visitor to email
# directly and offers a pre-filled mail link — nothing is silently dropped.
#
# 1. Create a key at https://resend.com
# 2. Verify healthcast.com.pk as a sending domain
# 3. Copy this file to .env.local and fill in the values

RESEND_API_KEY=
CONTACT_TO=healthcastpk1@gmail.com
CONTACT_FROM=HealthCast <website@healthcast.com.pk>
